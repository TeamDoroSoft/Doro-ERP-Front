# Browser requests always use same-origin /api/v1. This local Vite proxy target must be an Edge
# Runtime; for `npm run dev:admin`, start that Edge Runtime with the `admin` profile.
VITE_EDGE_PROXY_TARGET=http://localhost:8080

# Toss Payments payment-widget TEST client key (test_gck_... prefix) only.
# Never place a test_gsk secret key in VITE_* variables.
VITE_TOSS_CLIENT_KEY=

# Production browser origins. Leave empty for the single-origin localhost development flow.
VITE_PUBLIC_APP_ORIGIN=
VITE_KIOSK_APP_ORIGIN=
