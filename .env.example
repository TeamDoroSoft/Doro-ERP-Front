# Local development uses the Vite /api proxy so SESSION requests remain same-origin.
# You may set either an Edge origin (http://localhost:8080) or a full base URL ending in /api/v1.
# Set an external Edge origin only when that deployment explicitly supports credentialed CORS.
VITE_API_BASE_URL=
# For `npm run dev:admin`, this target must be an Edge Runtime started with the `admin` profile.
VITE_EDGE_PROXY_TARGET=http://localhost:8080

# Toss Payments payment-widget TEST client key (test_gck_... prefix) only.
# Never place a test_gsk secret key in VITE_* variables.
VITE_TOSS_CLIENT_KEY=
