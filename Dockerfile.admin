FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY admin.html vite.config.ts vite.admin.config.ts vitest.config.ts ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json tsconfig.vitest.json ./
COPY env.d.ts ./
COPY public ./public
COPY src ./src

RUN npm run build:admin

FROM nginxinc/nginx-unprivileged:stable-alpine

COPY nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/dist-admin /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
